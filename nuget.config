<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="InwayArtifacts" value="https://pkgs.dev.azure.com/InwaySystems/_packaging/InwayArtifacts/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="InwayArtifacts">
      <package pattern="Inway.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
