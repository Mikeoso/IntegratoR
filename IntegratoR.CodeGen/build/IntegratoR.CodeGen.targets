<Project>

  <!--
    MSBuild targets for IntegratoR OData entity generation.

    Usage in consumer .csproj:

    <PropertyGroup>
      <ODataMetadataSource>metadata.xml</ODataMetadataSource>
      <ODataOutputPath>Domain\Entities\Generated</ODataOutputPath>
      <ODataNamespace>MyApp.Domain.Entities</ODataNamespace>
    </PropertyGroup>

    <ItemGroup>
      <ODataEntity Include="LedgerJournalHeaders" />
      <ODataEntity Include="DimensionIntegrationFormats" />
    </ItemGroup>

    Then run: dotnet build -t:GenerateODataEntities
  -->

  <UsingTask
    TaskName="IntegratoR.CodeGen.Tasks.GenerateODataEntitiesTask"
    AssemblyFile="$(MSBuildThisFileDirectory)..\lib\net10.0\IntegratoR.CodeGen.dll" />

  <Target Name="GenerateODataEntities">
    <Error
      Condition="'$(ODataMetadataSource)' == ''"
      Text="ODataMetadataSource property is required. Set it to the path of your metadata.xml file." />

    <PropertyGroup>
      <ODataOutputPath Condition="'$(ODataOutputPath)' == ''">Domain\Entities\Generated</ODataOutputPath>
      <ODataNamespace Condition="'$(ODataNamespace)' == ''">$(RootNamespace).Domain.Entities.Generated</ODataNamespace>
    </PropertyGroup>

    <GenerateODataEntitiesTask
      MetadataSource="$(ODataMetadataSource)"
      OutputPath="$(ODataOutputPath)"
      Namespace="$(ODataNamespace)"
      Entities="@(ODataEntity, ';')" />
  </Target>

</Project>
