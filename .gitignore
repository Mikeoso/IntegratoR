## .gitignore for IntegratoR (.NET 10 / Azure Functions)

# IDE & Editor
.vs/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# Claude Code statusline (local config, not project content)
.ccstatusline/
**/.ccstatusline/

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/
publish/

# NuGet
*.nupkg
*.snupkg
*.nuget.props
*.nuget.targets
packages/

# MSBuild
*.binlog
[Bb]uild[Ll]og.*

# Test results & coverage
[Tt]est[Rr]esult*/
CodeCoverage/
coverage/
*.coverage
*.coveragexml

# Azure Functions
local.settings.json

# Secrets & environment
.env
.env.*
secrets.json
CLAUDE.local.md

# Claude Code local settings
.claude/settings.local.json
.claude/*.local.md
.claude/worktrees/

# Local tooling config (not committed). context7.json holds a per-project key —
# keep it local; .mcp.json defines per-developer MCP servers.
.mcp.json
context7.json

# OS files
Thumbs.db
.DS_Store

# Temp files
~$*
*~
