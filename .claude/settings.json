{
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "0"
  },
  "permissions": {
    "allow": [
      "Bash(dotnet *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(func *)",
      "Bash(pwsh *)",
      "Bash(npx *)",
      "Read(*)",
      "Edit(*)",
      "Create(*)",
      "Write(*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/scripts/guard-destructive.ps1",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/scripts/auto-format.ps1",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "prompt",
            "prompt": "You are evaluating whether Claude should stop. Context: $ARGUMENTS\n\nCheck the conversation for evidence that:\n1. `dotnet build` was run and passed (if code was changed)\n2. Relevant tests were run with `dotnet test` (if code was changed)\n3. Code review was delegated to reviewer agents (if code was changed)\n\nIf NO code was changed (e.g. research, planning, questions), respond {\"ok\": true}.\nIf code was changed and all 3 checks passed, respond {\"ok\": true}.\nIf code was changed and any check is missing, respond {\"ok\": false, \"reason\": \"<what is missing>\"}.",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest --config .ccstatusline/settings.json",
    "padding": 0
  },
  "enabledPlugins": {
    "plugin-dev@claude-settings": true,
    "claude-code-setup@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  },
  "autoUpdatesChannel": "latest",
  "enabledMcpjsonServers": [
    "microsoft-learn",
    "context7",
    "sequential-thinking"
  ]
}
